{
  "model_dir": "/workspace/datasets/sam3/models",
  "image_dir": "/workspace/datasets/db2/101.etc/dongwon/data1/JPEGImages",
  "label_dir": "/workspace/datasets/db2/101.etc/dongwon/data1/labels_sam3",
  "viz_dir": "./data/results",

  "classes": {
    "cow standing on four legs": 0,
    "cow lying flat on ground": 1
